### Target Vendor/Product (support only Ralink RT3883/MT7620)
CONFIG_VENDOR=NEXX
CONFIG_PRODUCT=MT7620
CONFIG_FIRMWARE_PRODUCT_ID=WT3020H16M
CONFIG_FIRMWARE_BOOT_RAM_128M=y
CONFIG_RT2880_DRAM_128M=y

############################################################
### Linux kernel configuration
############################################################

### Force MT7620 CPU clock to 600MHz (override Uboot settings)
#CONFIG_FIRMWARE_CPU_600MHZ=y

### Enable MT7620 CPU sleep mode (downclock to 200MHz on idle)
CONFIG_FIRMWARE_CPU_SLEEP=y

### Kernel driver select for WiFi AP 2.4GHz
### 2.7 = MT7620 v2.7.2.0
### 3.0 = MT7620 v3.0.4.0
CONFIG_FIRMWARE_WIFI2_DRIVER=3.0

# Базовая поддержка USB и накопителей
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_EXT4=y
CONFIG_FIRMWARE_ENABLE_EXFAT=y
CONFIG_FIRMWARE_ENABLE_FUSE=y
CONFIG_FIRMWARE_ENABLE_SWAP=y

# Ваша мультимедиа-тройка: Samba, FTP, Torrent (Transmission)
CONFIG_FIRMWARE_INCLUDE_SMBD=y
CONFIG_FIRMWARE_INCLUDE_FTPD=y
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=y

# Поддержка NTFS для дисков (если диск отформатирован в Windows)
CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

# Локализация
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
# Отключаем тяжелые VPN-сервисы и шифрование (они не нужны для локальной шары)
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=n
CONFIG_FIRMWARE_INCLUDE_QUIC=n
CONFIG_FIRMWARE_INCLUDE_STUBBY=n
CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=n
CONFIG_FIRMWARE_INCLUDE_DOH=n

# Отключаем тяжелый SSH-сервер OpenSSH (вместо него по умолчанию будет работать легкий Dropbear)
CONFIG_FIRMWARE_INCLUDE_OPENSSH=n
CONFIG_FIRMWARE_INCLUDE_SFTP=n

# Отключаем диагностический софт и прочие утилиты
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=n
CONFIG_FIRMWARE_INCLUDE_IPERF3=y     # Можно оставить для теста скорости, он легкий
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n     # Если не нужен DLNA-стриминг IPTV
CONFIG_FIRMWARE_INCLUDE_LUA=n
CONFIG_FIRMWARE_INCLUDE_CURL=n       # ЕслиTransmission не требует его жестко, отключаем
CONFIG_FIRMWARE_INCLUDE_IPSET=n

# Идентификатор платы (обычно используется профиль RT-N14U или WT3020)
FIRMWARE_PRODUCT_ID=WT3020H16M
FIRMWARE_VENDOR=NEXX

CONFIG_RT2880_DRAM_128M=y
CONFIG_FIRMWARE_BOOT_RAM_128M=y


# Настройка памяти под 128 МБ (ОБЯЗАТЕЛЬНО)
CONFIG_FIRMWARE_BOOT_RAM_128M=y

# Включение необходимых модулей для USB-диска Kimax
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_FAT=y
CONFIG_FIRMWARE_ENABLE_NTFS=y
CONFIG_FIRMWARE_ENABLE_EXT4=y
CONFIG_FIRMWARE_ENABLE_SAMBA=y
CONFIG_FIRMWARE_ENABLE_FTP=y

# Отключение ненужного для экономии места (по желанию)
CONFIG_FIRMWARE_INCLUDE_IPV6=n
CONFIG_FIRMWARE_INCLUDE_HTTPS=y
